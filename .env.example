# Database: local dev uses `npm run db:dev`; production uses Supabase (Connect → ORM → Prisma).
# Production: DATABASE_URL is the transaction pooler (port 6543, ?pgbouncer=true&connection_limit=1).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/coastal"
# Connection used for migrations; on Supabase, the session pooler (port 5432). Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/coastal"

# First admin account, created by `npm run db:seed` (change the password in Admin → Account afterwards)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=""

# Public URL of the site (used for the Paystack return link)
APP_URL="http://localhost:3000"

# Paystack → Settings → API Keys & Webhooks (use test keys until launch)
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Resend (https://resend.com) for confirmation emails; the sender domain must be verified
RESEND_API_KEY=""
EMAIL_FROM="Coastal Carnival <tickets@yourdomain.com>"

# Optional: Cloudinary for uploading images/video from the admin (cloudinary://key:secret@cloud_name)
CLOUDINARY_URL=""
